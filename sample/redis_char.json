{
    "collector": "bpfsnap",
    "vm_size_gb": 5,
    "interval": 5,
    "baseline_duration": 30,
    "collect_duration": 600,
    "stable_ticks": 60,
    "warmup_threshold_pct": 5,
    "warmup_consecutive": 3,
    "max_warmup_duration": 300,
    "num_runs": 3,
    "clone_buffer": 5,
    "base_vm_name": "redis_base",
    "clone_prefix": "redis_vm",
    "workload": {
        "type": "redis",
        "config": {
            "clients": 50,
            "requests": 1000000,
            "data_size": 64,
            "pipeline": 1,
            "threads": 4,
            "keyspace": 100000,
            "tests": "set,get"
        }
    }
}
